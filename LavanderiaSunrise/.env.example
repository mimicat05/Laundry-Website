# ─── Local Setup Instructions ──────────────────────────────────────────────
# 1. Copy this file:  copy .env.example .env.local   (Windows CMD / PowerShell)
# 2. Fill in YOUR_PASSWORD below (your PostgreSQL password)
# 3. Create the database: open pgAdmin or psql and run -> CREATE DATABASE lavanderia;
# 4. Run: npm run db:push     (creates all tables)
# 5. Run: npm run dev         (starts the app on http://localhost:5000)
# ───────────────────────────────────────────────────────────────────────────

# ─── Database (Required) ───────────────────────────────────────────────────
# Replace YOUR_PASSWORD with your local PostgreSQL password (set during install)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/lavanderia

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=YOUR_PASSWORD
PGDATABASE=lavanderia

# ─── Session (Required) ────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-any-long-random-string

# ─── Email (Optional) ──────────────────────────────────────────────────────
# Leave these commented out — email is disabled gracefully when not set.
# To enable: generate a Gmail App Password at https://myaccount.google.com/apppasswords
# GMAIL_USER=your-email@gmail.com
# GMAIL_PASSWORD=your-16-char-app-password
