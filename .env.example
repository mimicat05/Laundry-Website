# ─── Required ──────────────────────────────────────────────
# PostgreSQL connection string
# Local example (install PostgreSQL first, then create a database named "laundry"):
DATABASE_URL=postgresql://postgres:password@localhost:5432/laundry

# Secret used to sign session cookies — any long random string works
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Optional: Email (password reset & order notifications) ─
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate an App Password for "Mail"
# 3. Paste it below (no spaces)
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-16-char-app-password
